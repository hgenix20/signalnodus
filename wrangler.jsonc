{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signalnodus",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  // mppx and the Stripe SDK reach for node builtins.
  "compatibility_flags": ["nodejs_compat"],
  // Deliberately absent so this file is safe in a public repo. Deploys read it
  // from the CLOUDFLARE_ACCOUNT_ID environment variable instead.
  "routes": [
    { "pattern": "signalnodus.ai", "custom_domain": true },
    { "pattern": "www.signalnodus.ai", "custom_domain": true },
    { "pattern": "api.signalnodus.ai", "custom_domain": true },
    { "pattern": "mcp.signalnodus.ai", "custom_domain": true },
    { "pattern": "app.signalnodus.ai", "custom_domain": true },
    { "pattern": "staging.signalnodus.ai", "custom_domain": true },
    { "pattern": "dev.signalnodus.ai", "custom_domain": true }
  ],
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAEQZL0HWxzKNdU1w",
    "CONTACT_EMAIL": "hgenix@agentmail.to",
    // Receiving address for x402 on Base, issued by Stripe. Public by nature:
    // it is handed to every payer inside the 402 challenge.
    "BASE_DEPOSIT_ADDRESS": "0xcf7682647d17803f997308a10c191557d899ec30",
    "X402_FACILITATOR_URL": "https://x402.org/facilitator"
  },
  // The MCP endpoint is unauthenticated and every miss becomes one request
  // against SEC, who rate limit at 10 req/s and block by User-Agent. This caps
  // what a single caller can turn into upstream load.
  "d1_databases": [
    {
      "binding": "BILLING",
      "database_name": "signalnodus-billing",
      "database_id": "8d464cfd-9ac3-4eb1-b6cf-e1531458e650"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "MCP_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  },
  // compare_filings legitimately needs many seconds of CPU: it fetches and
  // sentence-diffs two filings that can each approach the 32MB document cap
  // (MSFT 10-Ks). 30s of Workers CPU costs a fraction of a cent, and only
  // paid or keyed calls ever reach the parser, so the ceiling is not an
  // abuse channel; do not read this as a sub-second guard.
  "limits": { "cpu_ms": 30000 },
  // Daily housekeeping: clear checkout rows nobody completed.
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": true }
}
